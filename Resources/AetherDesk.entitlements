<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: required to use CoreLocation (location toggle in System Settings
	     immediately reverts without this, regardless of sandbox status). -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
