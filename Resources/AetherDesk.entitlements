<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        AetherDesk runs unsandboxed by default for v1. The app needs broad
        filesystem access to import wallpaper bundles and needs network
        access so wallpapers can opt into weather / RSS / etc.

        If you enable sandboxing later, you'll likely need:
          com.apple.security.network.client           (network wallpapers)
          com.apple.security.files.user-selected.read-write  (import panel)
          com.apple.security.files.bookmarks.app-scope  (persistent access)
    -->
</dict>
</plist>
